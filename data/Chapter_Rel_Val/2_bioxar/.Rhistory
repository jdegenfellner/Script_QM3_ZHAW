library(pacman)
p_load(tidyverse, readxl)
# Read file
url <- "https://raw.githubusercontent.com/jdegenfellner/Script_QM2_ZHAW/main/data/chapter%205_assignment%201_2_wide.xls"
temp_file <- tempfile(fileext = ".xls")
download.file(url, temp_file, mode = "wb")  # mode="wb" is important for binary files
df <- read_excel(temp_file)
head(df)
# As in the book, let's randomly select 50 patients.
set.seed(123)
df <- df %>% sample_n(50)
dim(df)
df <- df %>%
dplyr::mutate(
ROMas.Mary_bias_5 = ROMas.Mary + 5,
ROMas.Mary_bias_15 = ROMas.Mary + 15,
ROMas.Mary_bias_35 = ROMas.Mary + 35
)
cor(df$ROMas.Peter, df$ROMas.Mary)
cor(df$ROMas.Peter, df$ROMas.Mary_bias_5)
cor(df$ROMas.Peter, df$ROMas.Mary_bias_15)
cor(df$ROMas.Peter, df$ROMas.Mary_bias_35)
library(pacman)
p_load(tidyverse, readxl)
# Read file
url <- "https://raw.githubusercontent.com/jdegenfellner/Script_QM2_ZHAW/main/data/chapter%205_assignment%201_2_wide.xls"
temp_file <- tempfile(fileext = ".xls")
download.file(url, temp_file, mode = "wb")  # mode="wb" is important for binary files
df <- read_excel(temp_file)
head(df)
# As in the book, let's randomly select 50 patients.
set.seed(123)
df <- df %>% sample_n(50)
dim(df)
# 1) Fit the linear model-----------
mod <- lm(ROMas.Mary ~ ROMas.Peter, data = df)
summary(mod)
# 2) Residuals-------------
df <- df %>%
mutate(pred_mary = predict(mod),
residuals = ROMas.Mary - pred_mary)
ggplot(df, aes(x = pred_mary, y = residuals)) +
geom_point() +
geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
theme_minimal() +
labs(x = "Predicted Mary's ROM", y = "Residuals")
# 3) MAD-----------
MAD <- mean(abs(df$ROMas.Mary - df$pred_mary))
MAD
library(pacman)
p_load(tidyverse, readxl, lme4, performance, car)
# Read file
url <- "https://raw.githubusercontent.com/jdegenfellner/Script_QM2_ZHAW/main/data/chapter%205_assignment%201_2_wide.xls"
temp_file <- tempfile(fileext = ".xls")
download.file(url, temp_file, mode = "wb")  # mode="wb" is important for binary files
df <- read_excel(temp_file)
head(df)
head(df)
# As in the book, let's randomly select 50 patients.
set.seed(123)
df <- df %>% sample_n(50)
dim(df)
df_long <- df %>%
mutate(ID = row_number()) %>%
dplyr::select(ID,ROMas.Peter, ROMas.Mary) %>%
pivot_longer(cols = c(ROMas.Peter, ROMas.Mary),
names_to = "Rater", values_to = "ROM") %>%
mutate(Rater = factor(Rater))
df_long
unique(df_long$Rater)
df_long_bias <- df_long %>%
mutate(ROM = ROM + ifelse(Rater == "ROMas.Mary", 5, 0))
head(df_long_bias)
# Model 1 (for ICC1)-----------
mod1 <- lmer(ROM ~ (1|ID), data = df_long_bias)
summary(mod1)
# Model 2 (for ICC2/3)-----------
mod2 <- lmer(ROM ~ (1|ID) + (1|Rater), data = df_long_bias)
summary(mod2)
# 1) Check model 1
check_model(mod1)
# 1) Check model 1
check_model(mod1)
check_model(mod1, check = "pp_check")
check_model(mod1, check = "normality")
check_model(mod1, check = "qq")
library(DHARMa)
sim <- simulateResiduals(fittedModel = mod1, plot = FALSE)
plotQQunif(sim)  # includes confidence band
library(qqplotr)
library(ggplot2)
res <- residuals(mod1)
ggplot(data.frame(res = res), aes(sample = res)) +
stat_qq_band(distribution = "norm", alpha = 0.3) +
stat_qq_line(distribution = "norm") +
stat_qq_point(distribution = "norm") +
labs(title = "QQ Plot with Confidence Band")
onflicts_prefer(qqplotr::stat_qq_line)
res <- residuals(mod1)
ggplot(data.frame(res = res), aes(sample = res)) +
stat_qq_band(distribution = "norm", alpha = 0.3) +
stat_qq_line(distribution = "norm") +
stat_qq_point(distribution = "norm") +
labs(title = "QQ Plot with Confidence Band")
conflicts_prefer(ggplot2::stat_qq_line)
res <- residuals(mod1)
ggplot(data.frame(res = res), aes(sample = res)) +
stat_qq_band(distribution = "norm", alpha = 0.3) +
stat_qq_line(distribution = "norm") +
stat_qq_point(distribution = "norm") +
labs(title = "QQ Plot with Confidence Band")
conflicts_prefer(ggplot2::stat_qq_line)
res <- residuals(mod1)
ggplot(data.frame(res = res), aes(sample = res)) +
stat_qq_band(distribution = "norm", alpha = 0.3) +
stat_qq_line(distribution = "norm") +
stat_qq_point(distribution = "norm") +
labs(title = "QQ Plot with Confidence Band")
conflicts_prefer(ggplot2::stat_qq_line)
res <- residuals(mod1)
ggplot(data.frame(res = res), aes(sample = res)) +
stat_qq_band(distribution = "norm", alpha = 0.3) +
stat_qq_line(distribution = "norm") +
stat_qq_point(distribution = "norm") +
labs(title = "QQ Plot with Confidence Band")
conflicts_prefer(ggplot2::stat_qq_line)
res <- residuals(mod1)
ggplot(data.frame(res = res), aes(sample = res)) +
qqplotr::stat_qq_band(distribution = "norm", alpha = 0.3) +
qqplotr::stat_qq_line(distribution = "norm") +
qqplotr::stat_qq_point(distribution = "norm") +
labs(title = "QQ Plot with Confidence Band")
library(qqplotr)
res <- residuals(mod1)
ggplot(data.frame(res = res), aes(sample = res)) +
qqplotr::stat_qq_band(distribution = "norm", alpha = 0.3) +
qqplotr::stat_qq_line(distribution = "norm") +
qqplotr::stat_qq_point(distribution = "norm") +
labs(title = "QQ Plot with Confidence Band")
# PPC seems a bit off
# Linearity is not perfect
qqnorm(residuals(mod1))
qqline(residuals(mod1))
# 2) Check model 2
check_model(mod2)
check_model(mod2, check = "pp_check")
check_model(mod2, check = "normality")
check_model(mod2, check = "qq")
res <- residuals(mod2)
ggplot(data.frame(res = res), aes(sample = res)) +
qqplotr::stat_qq_band(distribution = "norm", alpha = 0.3) +
qqplotr::stat_qq_line(distribution = "norm") +
qqplotr::stat_qq_point(distribution = "norm") +
labs(title = "QQ Plot with Confidence Band")
# 2) Check model 2
check_model(mod2)
# 1) Residuen extrahieren + in DataFrame
resid_df <- bind_rows(
data.frame(model = "mod1", resid = residuals(mod1)),
data.frame(model = "mod2", resid = residuals(mod2))
)
# 2) Gleiche Achsenskalierung berechnen
resid_range <- range(resid_df$resid)
# 3) Plot 1: Histogramm mod1
p1 <- resid_df %>% dplyr::filter(model == "mod1") %>%
ggplot(aes(x = resid)) +
geom_histogram(bins = 30, fill = "skyblue", color = "black") +
xlim(resid_range) +
labs(title = "Residuen: mod1", x = "Residual", y = "Häufigkeit") +
theme_minimal()
# 4) Plot 2: Histogramm mod2
p2 <- resid_df %>% dplyr::filter(model == "mod2") %>%
ggplot(aes(x = resid)) +
geom_histogram(bins = 30, fill = "orange", color = "black") +
xlim(resid_range) +
labs(title = "Residuen: mod2", x = "Residual", y = "Häufigkeit") +
theme_minimal()
# 5) Nebeneinander anzeigen
p1 + p2
summary(residuals(mod1))
summary(residuals(mod2))
WAIC(mod1)
WAIC(mod2)
AIC(mod1)
AIC(mod2)
BIC(mod1)
BIC(mod2)
